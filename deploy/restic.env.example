# Install as /srv/portal-financeiro/secrets/restic.env (0600); never commit filled values.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/backup-financas/portal-financeiro/restic
RESTIC_PASSWORD_FILE=/srv/portal-financeiro/secrets/restic_password
AWS_ACCESS_KEY_ID=SET_DEDICATED_BUCKET_KEY
AWS_SECRET_ACCESS_KEY=SET_DEDICATED_BUCKET_SECRET
AWS_DEFAULT_REGION=auto
