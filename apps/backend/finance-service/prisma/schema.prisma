generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // 'income' | 'expense'
  category    String
  date        DateTime
  isShared    Boolean
  isFixed     Boolean  @default(false)
  payer       String   // 'me' | 'spouse'
  createdAt   DateTime @default(now())
  recurrenceId String?
  splitDetails Json?
  
  userId      String   // Logical reference to IdentityService User
  shares      ExpenseShare[]

  @@index([userId, date])
  @@index([userId, recurrenceId, date])
}

model Category {
  id   String @id @default(uuid())
  name String
  type String // 'income' | 'expense'
  
  userId String // Logical reference to IdentityService User
  @@index([userId])
}

model GroupMember {
  id        String   @id @default(uuid())
  name      String
  surname   String?
  email     String?
  category  String   // 'Filho(a)', 'Cônjuge', 'Pai(a)', etc.
  userId    String
  createdAt DateTime @default(now())
  connection MemberConnection?
  @@index([userId])
}

model MemberConnection {
  id String @id @default(uuid())
  memberId String @unique
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ownerId String
  ownerName String
  email String
  recipientId String?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([email, status])
  @@index([recipientId, status])
  @@index([ownerId])
}

model ExpenseShare {
  id String @id @default(uuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ownerId String
  recipientId String
  memberId String
  ownerName String
  description String
  amountCents Int
  totalCents Int
  date DateTime
  paidByRecipient Boolean @default(false)
  status String @default("pending")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@unique([transactionId, recipientId])
  @@index([recipientId, status, date])
  @@index([ownerId, status])
  @@index([memberId, status])
}

model BudgetRule {
  id         String   @id @default(uuid())
  userId     String   // Logical reference to User
  month      String   // Format: YYYY-MM
  divisions  Json     @default("[]") // Array of custom divisions
  mapping    Json     @default("{}") // e.g. { "Mercado": "divisionId_1" }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, month])
}
