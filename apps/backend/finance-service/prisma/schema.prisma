generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Decimal @db.Decimal(16, 2)
  type        String   // 'income' | 'expense'
  category    String
  date        DateTime
  isShared    Boolean
  isFixed     Boolean  @default(false)
  payer       String   // 'me' | 'spouse'
  createdAt   DateTime @default(now())
  recurrenceId String?
  splitDetails Json?
  
  userId      String   // Logical reference to IdentityService User
  shares      ExpenseShare[]
  categoryId String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  splits TransactionSplit[]
  @@index([categoryId])

  @@index([userId, date])
  @@index([userId, recurrenceId, date])
}

model TransactionSplit {
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  participantKey String
  memberId String?
  member GroupMember? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountCents Int
  @@id([transactionId, participantKey])
  @@index([memberId])
}

model Category {
  id   String @id @default(uuid())
  name String
  type String // 'income' | 'expense'
  transactions Transaction[]
  
  userId String // Logical reference to IdentityService User
  @@index([userId])
}

model GroupMember {
  id        String   @id @default(uuid())
  name      String
  surname   String?
  email     String?
  category  String   // 'Filho(a)', 'Cônjuge', 'Pai(a)', etc.
  userId    String
  createdAt DateTime @default(now())
  connection MemberConnection?
  splits TransactionSplit[]
  @@index([userId])
}

model MemberConnection {
  id String @id @default(uuid())
  memberId String @unique
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ownerId String
  ownerName String
  email String
  recipientId String?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([email, status])
  @@index([recipientId, status])
  @@index([ownerId])
}

model ExpenseShare {
  id String @id @default(uuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ownerId String
  recipientId String
  memberId String
  ownerName String
  description String
  amountCents Int
  totalCents Int
  date DateTime
  paidByRecipient Boolean @default(false)
  status String @default("pending")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@unique([transactionId, recipientId])
  @@index([recipientId, status, date])
  @@index([ownerId, status])
  @@index([memberId, status])
}

model BudgetRule {
  id         String   @id @default(uuid())
  userId     String   // Logical reference to User
  month      String   // Format: YYYY-MM
  divisions  Json     @default("[]") // Array of custom divisions
  revision   Int      @default(0)
  versions   BudgetRuleVersion[]
  mapping    Json     @default("{}") // e.g. { "Mercado": "divisionId_1" }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, month])
}

model BudgetRuleVersion {
  id String @id @default(uuid())
  ruleId String
  rule BudgetRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  revision Int
  divisions Json
  mapping Json
  createdAt DateTime @default(now())
  @@unique([ruleId, revision])
}

model RequestBudget {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}
